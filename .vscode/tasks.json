{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "graaljs: run current file",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/run.ps1", "${file}"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "maven: compile",
      "type": "shell",
      "command": "mvn -q compile",
      "problemMatcher": ["$javac"]
    }
  ]
}
